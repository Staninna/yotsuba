<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 lists the top 3, 4x2 the top 6, anything taller scrolls (see WatchedThreadsWidget).
     updatePeriodMillis matches BookmarkRefreshWorker's 30 min cadence: the launcher-driven
     update is the durable backstop for when no Glance session is alive to observe the
     bookmarks flow. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_watched_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="600dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/glance_default_loading_layout" />
